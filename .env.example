# ---------------------------------------------------------------------------
# Traxen — variáveis de ambiente
# Copie este arquivo para .env.local e preencha com valores reais em produção.
# NENHUM segredo deste arquivo pode ser exposto ao navegador (nunca usar
# prefixo NEXT_PUBLIC_ em chaves sensíveis).
# ---------------------------------------------------------------------------

# Banco de dados (Prisma / PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/traxen?schema=public"

# Autenticação (Auth.js ou equivalente)
AUTH_SECRET="troque-por-um-valor-aleatorio-de-32-bytes"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Redis (rate limiting / cache / filas)
REDIS_URL="redis://localhost:6379"

# Provedor de dados veiculares (bureau/API contratada)
# Em desenvolvimento, o adapter "mock" é usado automaticamente.
VEHICLE_PROVIDER="mock" # mock | provider-a | provider-b
VEHICLE_PROVIDER_API_KEY=""
VEHICLE_PROVIDER_BASE_URL=""

# Gateway de pagamento (PIX / Cartão)
PAYMENT_PROVIDER="mock" # mock | gateway-a | gateway-b
PAYMENT_PROVIDER_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# Geração de PDF
PDF_SERVICE_URL=""

# Aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"
